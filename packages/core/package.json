{
  "name": "@openskein/core",
  "version": "0.1.3",
  "description": "openskein 纯内核：状态机 + 定义校验 + 事件存储 + 工具 + schema 迁移 + 干跑",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node -e \"console.error('请勿直接 npm publish；请用 npm run publish:all（含完整构建+校验）');process.exit(1)\""
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  }
}
