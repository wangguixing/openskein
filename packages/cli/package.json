{
  "name": "@openskein/cli",
  "version": "0.1.3",
  "description": "openskein 命令行：validate / list / sim / status / check / install / doctor / uninstall",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "development": "./src/cli.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "skein": "./bin/skein.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node -e \"console.error('请勿直接 npm publish；请用 npm run publish:all（含完整构建+校验）');process.exit(1)\""
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openskein/core": "^0.1.3",
    "@openskein/catalog": "^0.1.3"
  }
}
