{
  "name": "@openskein/mcp",
  "version": "0.1.3",
  "description": "openskein 的 MCP server（stdio，暴露 skein_* 工具）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./handlers": {
      "types": "./dist/handlers.d.ts",
      "development": "./src/handlers.ts",
      "import": "./dist/handlers.js"
    }
  },
  "bin": {
    "skein-mcp": "./bin/skein-mcp.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node -e \"console.error('请勿直接 npm publish；请用 npm run publish:all（含完整构建+校验）');process.exit(1)\""
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@openskein/core": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
